(* Weak secrets and non-interference.
   A hash of the password is published: an off-line dictionary attack
   recovers it, so the weak secret property fails.  The session secret
   only appears encrypted under a fresh key, so it is non-interferent. *)

free c: channel.
type key.
fun h(bitstring): bitstring.
fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

free pw: bitstring [private].
free secretMsg: bitstring [private].

weaksecret pw.
noninterf secretMsg.

process
  ( out(c, h(pw)) ) | ( new k: key; out(c, senc(secretMsg, k)) )
