(* Strong secrecy as observational equivalence of a biprocess.
   Deterministic encryption leaks equality of plaintexts: the attacker
   compares two ciphertexts, so the equivalence does not hold. *)

free c: channel.
type key.
fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

free m1, m2: bitstring.

process
  new k: key;
  ( out(c, senc(choice[m1, m2], k)) | out(c, senc(m1, k)) )
