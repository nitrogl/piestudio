msgid_plural "And {count} more."
msgstr[0] "E un altro."
msgstr[1] "E altri {count}."

#: src/app/language/PvSettings.ts:24
msgid "An active attacker reads, writes and blocks public channels; a passive one only listens."
msgstr "Un attaccante attivo legge, scrive e blocca i canali pubblici; uno passivo si limita ad ascoltare."

#: src/app/language/PvSettings.ts:25
msgid "Compromise of session keys of other sessions."
msgstr "Compromissione delle chiavi di sessione di altre sessioni."

#: src/app/language/PvSettings.ts:26
msgid "Allow private communications on public terms."
msgstr "Permette comunicazioni private su termini pubblici."

#: src/app/language/PvSettings.ts:27
msgid "Allow choice/diff inside patterns."
msgstr "Permette choice/diff dentro i pattern."

#: src/app/language/PvSettings.ts:28
msgid "Make every input, get and let...suchthat precise."
msgstr "Rende precisi ogni input, get e let...suchthat."

#: src/app/language/PvSettings.ts:29
msgid "Ignore types during verification (types are still checked when parsing)."
msgstr "Ignora i tipi durante la verifica (i tipi vengono comunque controllati durante l'analisi sintattica)."

#: src/app/language/PvSettings.ts:30
msgid "Move restrictions downwards before translating to clauses."
msgstr "Sposta le restrizioni verso il basso prima della traduzione in clausole."

#: src/app/language/PvSettings.ts:31
msgid "Move let bindings downwards before translating to clauses."
msgstr "Sposta i legami let verso il basso prima della traduzione in clausole."

#: src/app/language/PvSettings.ts:32
msgid "Include terms of the equational theory in the arguments of names."
msgstr "Include i termini della teoria equazionale negli argomenti dei nomi."

#: src/app/language/PvSettings.ts:33
msgid "Expand let terms precisely."
msgstr "Espande con precisione i termini let."

#: src/app/language/PvSettings.ts:34
msgid "Prove lemmas by induction by default."
msgstr "Dimostra i lemmi per induzione, per impostazione predefinita."

#: src/app/language/PvSettings.ts:35
msgid "Prove queries by induction by default."
msgstr "Dimostra le query per induzione, per impostazione predefinita."

#: src/app/language/PvSettings.ts:36
msgid "Remove events that are only used by lemmas."
msgstr "Rimuove gli eventi usati solo dai lemmi."

#: src/app/language/PvSettings.ts:37
msgid "How lemmas are applied during saturation."
msgstr "Come si applicano i lemmi durante la saturazione."

#: src/app/language/PvSettings.ts:38
msgid "How lemmas are applied during verification."
msgstr "Come si applicano i lemmi durante la verifica."

#: src/app/language/PvSettings.ts:39
msgid "Display the application of lemmas."
msgstr "Mostra l'applicazione dei lemmi."

#: src/app/language/PvSettings.ts:40
msgid "Ignore nounif declarations a few times."
msgstr "Ignora alcune volte le dichiarazioni nounif."

#: src/app/language/PvSettings.ts:41
msgid "How many times nounif declarations are ignored."
msgstr "Quante volte si ignorano le dichiarazioni nounif."

#: src/app/language/PvSettings.ts:42
msgid "Selection function of the resolution."
msgstr "Funzione di selezione della risoluzione."

#: src/app/language/PvSettings.ts:43
msgid "Stop when the resolution may not terminate."
msgstr "Si ferma quando la risoluzione potrebbe non terminare."

#: src/app/language/PvSettings.ts:44
msgid "Elimination of redundant clauses."
msgstr "Eliminazione delle clausole ridondanti."

#: src/app/language/PvSettings.ts:45
msgid "Elimination of redundant hypotheses."
msgstr "Eliminazione delle ipotesi ridondanti."

#: src/app/language/PvSettings.ts:46
msgid "Maximum depth of terms in clauses (an approximation)."
msgstr "Profondità massima dei termini nelle clausole (un'approssimazione)."

#: src/app/language/PvSettings.ts:47
msgid "Maximum number of hypotheses of clauses (an approximation)."
msgstr "Numero massimo di ipotesi delle clausole (un'approssimazione)."

#: src/app/language/PvSettings.ts:48
msgid "Maximum length of chains of inequalities."
msgstr "Lunghezza massima delle catene di disuguaglianze."

#: src/app/language/PvSettings.ts:49
msgid "Simplify equalities at the end of saturation."
msgstr "Semplifica le uguaglianze alla fine della saturazione."

#: src/app/language/PvSettings.ts:50
msgid "Check that all terms of clauses are in normal form."
msgstr "Controlla che tutti i termini delle clausole siano in forma normale."

#: src/app/language/PvSettings.ts:51
msgid "Treatment of equations."
msgstr "Trattamento delle equazioni."

#: src/app/language/PvSettings.ts:52
msgid "Ordering of function symbols for the termination of equations."
msgstr "Ordinamento dei simboli di funzione per la terminazione delle equazioni."

#: src/app/language/PvSettings.ts:53
msgid "Check that predicates can be implemented."
msgstr "Controlla che i predicati si possano implementare."

#: src/app/language/PvSettings.ts:54
msgid "Threshold for cleaning up the clause database (percent)."
msgstr "Soglia per ripulire la base di clausole (in percentuale)."

#: src/app/language/PvSettings.ts:55
msgid "Maximum depth of the unification index."
msgstr "Profondità massima dell'indice di unificazione."

#: src/app/language/PvSettings.ts:56
msgid "Reconstruct attack traces (yes, no, or the number of attempts)."
msgstr "Ricostruisce le tracce d'attacco (yes, no, o il numero di tentativi)."

#: src/app/language/PvSettings.ts:57
msgid "Backtrack when reconstructing traces."
msgstr "Torna indietro (backtracking) durante la ricostruzione delle tracce."

#: src/app/language/PvSettings.ts:58
msgid "Unify derivations to help trace reconstruction."
msgstr "Unifica le derivazioni per aiutare la ricostruzione delle tracce."

#: src/app/language/PvSettings.ts:59
msgid "Reconstruct derivations."
msgstr "Ricostruisce le derivazioni."

#: src/app/language/PvSettings.ts:60
msgid "Simplify derivations."
msgstr "Semplifica le derivazioni."

#: src/app/language/PvSettings.ts:61
msgid "Explain derivations in English."
msgstr "Spiega le derivazioni in inglese."

#: src/app/language/PvSettings.ts:62
msgid "Display derivations."
msgstr "Mostra le derivazioni."

#: src/app/language/PvSettings.ts:63
msgid "Abbreviate names in derivations."
msgstr "Abbrevia i nomi nelle derivazioni."

#: src/app/language/PvSettings.ts:64
msgid "How attack traces are displayed."
msgstr "Come si mostrano le tracce d'attacco."

#: src/app/language/PvSettings.ts:65
msgid "Display the generated clauses."
msgstr "Mostra le clausole generate."

#: src/app/language/PvSettings.ts:66
msgid "Remove subsumed clauses before displaying them."
msgstr "Rimuove le clausole sussunte prima di mostrarle."

#: src/app/language/PvSettings.ts:67
msgid "Abbreviate clauses when displaying them."
msgstr "Abbrevia le clausole quando le mostra."

#: src/app/language/PvSettings.ts:68
msgid "Use ANSI colours in the output."
msgstr "Usa i colori ANSI nell'output."

#: src/app/language/PvSettings.ts:69
msgid "Display the clause database."
msgstr "Mostra la base di clausole."

#: src/app/language/PvSettings.ts:70
msgid "Display statistics while saturating."
msgstr "Mostra le statistiche durante la saturazione."

#: src/app/language/PvSettings.ts:71
msgid "Display \"goal reachable\" clauses."
msgstr "Mostra le clausole \"goal reachable\"."

#: src/app/language/PvSettings.ts:72
msgid "Display rules."
msgstr "Mostra le regole."

#: src/app/language/PvSettings.ts:73
msgid "Display redundant clauses."
msgstr "Mostra le clausole ridondanti."

#: src/app/language/PvSettings.ts:74
msgid "Display completed clauses."
msgstr "Mostra le clausole completate."

#: src/app/language/PvSettings.ts:75
msgid "Display information on equations."
msgstr "Mostra informazioni sulle equazioni."

#: src/app/language/PvSettings.ts:76
msgid "Display termination warnings."
msgstr "Mostra gli avvisi di terminazione."

#: src/app/language/PvSettings.ts:77
msgid "Display information on destructors."
msgstr "Mostra informazioni sui distruttori."

#: src/app/language/PvSettings.ts:78
msgid "Simplify biprocesses before proving equivalences."
msgstr "Semplifica i biprocessi prima di dimostrare le equivalenze."

#: src/app/language/PvSettings.ts:79
msgid "Reject simplified processes containing choice[true, false]."
msgstr "Rifiuta i processi semplificati che contengono choice[true, false]."

#: src/app/language/PvSettings.ts:80
msgid "Reject processes that cannot be simplified."
msgstr "Rifiuta i processi che non si possono semplificare."

#: src/app/language/PvSettings.ts:81
msgid "Simplify tests on constants when expanding terms."
msgstr "Semplifica i test sulle costanti durante l'espansione dei termini."

#: src/app/language/PvSettings.ts:82
msgid "Deprecated."
msgstr "Deprecato."

#: src/app/language/PvSettings.ts:83
msgid "Choose swappings of synchronisations interactively."
msgstr "Sceglie in modo interattivo gli scambi delle sincronizzazioni."

#: src/app/language/PvSettings.ts:84
msgid "Swapping of synchronisations, e.g. \"tag1 -> tag2\"."
msgstr "Scambio delle sincronizzazioni, per esempio \"tag1 -> tag2\"."

#: src/app/language/PvSettings.ts:85
msgid "Record features of clauses."
msgstr "Registra le caratteristiche delle clausole."

#: src/app/language/PvSettings.ts:86
msgid "Record function symbols as features."
msgstr "Registra i simboli di funzione come caratteristiche."

#: src/app/language/PvSettings.ts:87
msgid "Record names as features."
msgstr "Registra i nomi come caratteristiche."

#: src/app/language/PvSettings.ts:88
msgid "Record predicates as features."
msgstr "Registra i predicati come caratteristiche."

#: src/app/language/PvSettings.ts:89
msgid "Record events as features."
msgstr "Registra gli eventi come caratteristiche."

#: src/app/language/PvSettings.ts:90
msgid "Record tables as features."
msgstr "Registra le tabelle come caratteristiche."

#: src/app/language/PvSettings.ts:91
msgid "Record the depth of terms as a feature."
msgstr "Registra la profondità dei termini come caratteristica."

#: src/app/language/PvSettings.ts:92
msgid "Record the width of terms as a feature."
msgstr "Registra l'ampiezza dei termini come caratteristica."

#: src/app/language/PvSettings.ts:101
msgid "Attacker model"
msgstr "Modello dell'attaccante"

#: src/app/language/PvSettings.ts:101
msgid "Syntax"
msgstr "Sintassi"

#: src/app/language/PvSettings.ts:101
msgid "Precision"
msgstr "Precisione"

#: src/app/language/PvSettings.ts:101
msgid "Lemmas"
msgstr "Lemmi"

#: src/app/language/PvSettings.ts:101
msgid "Attack reconstruction"
msgstr "Ricostruzione degli attacchi"

#: src/app/language/PvSettings.ts:102
msgid "Resolution"
msgstr "Risoluzione"

#: src/app/language/PvSettings.ts:102
msgid "Process simplification"
msgstr "Semplificazione dei processi"

#: src/app/language/PvSettings.ts:102
msgid "Display"
msgstr "Visualizzazione"

#: src/app/language/PvSettings.ts:102
msgid "Features"
msgstr "Caratteristiche"

#: src/app/language/PvExplain.ts:16
msgid "Declares a type, for names, variables and the arguments of functions."
msgstr "Dichiara un tipo, per nomi, variabili e argomenti delle funzioni."

#: src/app/language/PvExplain.ts:17
msgid "Declares free names, which the attacker knows unless they are [private]: public channels, or secrets."
msgstr "Dichiara nomi liberi, che l'attaccante conosce a meno che non siano [private]: canali pubblici o segreti."

#: src/app/language/PvExplain.ts:18
msgid "Declares constants: functions without arguments."
msgstr "Dichiara costanti: funzioni senza argomenti."

#: src/app/language/PvExplain.ts:19
msgid "Declares a constructor, a function that builds terms such as encryptions; the attacker can apply it unless it is [private]."
msgstr "Dichiara un costruttore, una funzione che costruisce termini come le cifrature; l'attaccante può applicarlo a meno che non sia [private]."

#: src/app/language/PvExplain.ts:20
msgid "Declares a destructor by rewrite rules, such as decryption: sdec(senc(m, k), k) = m. When no rule applies, it fails."
msgstr "Dichiara un distruttore con regole di riscrittura, come la decifratura: sdec(senc(m, k), k) = m. Quando nessuna regola si applica, fallisce."

#: src/app/language/PvExplain.ts:21
msgid "Declares equations between terms, such as the commutativity of exponentiation in Diffie-Hellman."
msgstr "Dichiara equazioni tra termini, come la commutatività dell'esponenziazione in Diffie-Hellman."

#: src/app/language/PvExplain.ts:22
msgid "Declares a predicate, for clauses and for the conditions of queries."
msgstr "Dichiara un predicato, per le clausole e per le condizioni delle query."

#: src/app/language/PvExplain.ts:23
msgid "Declares a table: processes insert rows into it and look them up with get; the attacker cannot read it."
msgstr "Dichiara una tabella: i processi vi inseriscono righe e le cercano con get; l'attaccante non può leggerla."

#: src/app/language/PvExplain.ts:24
msgid "Declares or executes an event: events mark points of the protocol, for correspondence queries."
msgstr "Dichiara o esegue un evento: gli eventi segnano punti del protocollo, per le query di corrispondenza."

#: src/app/language/PvExplain.ts:25
msgid "Asks a security property: the secrecy of a term (attacker(s)), or a correspondence between events (==>)."
msgstr "Chiede una proprietà di sicurezza: la segretezza di un termine (attacker(s)) o una corrispondenza tra eventi (==>)."

#: src/app/language/PvExplain.ts:26
msgid "States a property that ProVerif proves first, then uses to prove the queries."
msgstr "Enuncia una proprietà che ProVerif dimostra per prima, poi usa per dimostrare le query."

#: src/app/language/PvExplain.ts:27
msgid "States a property that ProVerif assumes without proof, to help prove the queries."
msgstr "Enuncia una proprietà che ProVerif assume senza dimostrarla, per aiutare a dimostrare le query."

#: src/app/language/PvExplain.ts:28
msgid "Restricts the traces to those that satisfy a property."
msgstr "Restringe le tracce a quelle che soddisfano una proprietà."

#: src/app/language/PvExplain.ts:29
msgid "Asks for strong secrecy: the attacker cannot tell runs apart when the given names change value."
msgstr "Chiede la segretezza forte: l'attaccante non distingue le esecuzioni quando i nomi indicati cambiano valore."

#: src/app/language/PvExplain.ts:30
msgid "Asks whether a weak secret, such as a password, resists offline guessing."
msgstr "Chiede se un segreto debole, come una password, resiste agli attacchi a tentativi offline."

#: src/app/language/PvExplain.ts:31
msgid "A secrecy assumption: a fact that never holds. ProVerif checks it, and uses it to speed up the proof."
msgstr "Un'ipotesi di segretezza: un fatto che non vale mai. ProVerif la verifica e la usa per accelerare la dimostrazione."

#: src/app/language/PvExplain.ts:32
msgid "A hint for the resolution: do not resolve on facts of this form. It changes speed and termination, not soundness."
msgstr "Un suggerimento per la risoluzione: non risolvere su fatti di questa forma. Cambia velocità e terminazione, non la correttezza."

#: src/app/language/PvExplain.ts:33
msgid "A hint for the resolution: resolve on facts of this form first."
msgstr "Un suggerimento per la risoluzione: risolvi prima su fatti di questa forma."

#: src/app/language/PvExplain.ts:34
msgid "Defines a function by a term, expanded where it is used."
msgstr "Definisce una funzione con un termine, espanso dove viene usato."

#: src/app/language/PvExplain.ts:35
msgid "Binds a variable or matches a pattern: let x = M in P. It also defines a process macro: let P(x: T) = ..."
msgstr "Lega una variabile o confronta un pattern: let x = M in P. Definisce anche una macro di processo: let P(x: T) = ..."

#: src/app/language/PvExplain.ts:36
msgid "Starts the main process: the roles of the protocol, usually in parallel and replicated."
msgstr "Inizia il processo principale: i ruoli del protocollo, di solito in parallelo e replicati."

#: src/app/language/PvExplain.ts:37
msgid "Creates a fresh name that the attacker does not know: a nonce or a key."
msgstr "Crea un nome nuovo che l'attaccante non conosce: un nonce o una chiave."

#: src/app/language/PvExplain.ts:38
msgid "Receives a message on a channel: in(c, x: T); on a public channel it comes from the attacker. Also ends a let: let x = M in P."
msgstr "Riceve un messaggio su un canale: in(c, x: T); su un canale pubblico arriva dall'attaccante. Chiude anche un let: let x = M in P."

#: src/app/language/PvExplain.ts:39
msgid "Sends a message on a channel: out(c, M); on a public channel the attacker gets it."
msgstr "Invia un messaggio su un canale: out(c, M); su un canale pubblico l'attaccante lo riceve."

#: src/app/language/PvExplain.ts:40
msgid "A test: if M then P else Q."
msgstr "Un test: if M then P else Q."

#: src/app/language/PvExplain.ts:41
msgid "What runs when the test, the match or the lookup succeeds."
msgstr "Ciò che viene eseguito quando il test, il confronto o la ricerca riesce."

#: src/app/language/PvExplain.ts:42
msgid "What runs when the test, the match or the lookup fails."
msgstr "Ciò che viene eseguito quando il test, il confronto o la ricerca fallisce."

#: src/app/language/PvExplain.ts:43
msgid "Inserts a row into a table: insert t(M1, ..., Mn)."
msgstr "Inserisce una riga in una tabella: insert t(M1, ..., Mn)."

#: src/app/language/PvExplain.ts:44
msgid "Looks up a row of a table that matches a pattern: get t(=M, x) in P else Q."
msgstr "Cerca una riga di una tabella che corrisponde a un pattern: get t(=M, x) in P else Q."

#: src/app/language/PvExplain.ts:45
msgid "A condition: get ... suchthat M, or let x suchthat p(x), which picks any value that satisfies it."
msgstr "Una condizione: get ... suchthat M, oppure let x suchthat p(x), che sceglie un valore qualsiasi che la soddisfa."

#: src/app/language/PvExplain.ts:46
msgid "Starts a new phase: earlier processes stop, and the attacker keeps what it knows. Used for forward secrecy."
msgstr "Inizia una nuova fase: i processi precedenti si fermano e l'attaccante conserva ciò che sa. Si usa per la forward secrecy."

#: src/app/language/PvExplain.ts:47
msgid "A synchronisation barrier: processes wait for each other at sync n."
msgstr "Una barriera di sincronizzazione: i processi si attendono a vicenda in sync n."

#: src/app/language/PvExplain.ts:48
msgid "A biprocess: choice[M, N] is M on the left and N on the right; ProVerif proves the two sides equivalent."
msgstr "Un biprocesso: choice[M, N] è M a sinistra e N a destra; ProVerif dimostra che i due lati sono equivalenti."

#: src/app/language/PvExplain.ts:49
msgid "A biprocess: diff[M, N] is M on the left and N on the right; ProVerif proves the two sides equivalent."
msgstr "Un biprocesso: diff[M, N] è M a sinistra e N a destra; ProVerif dimostra che i due lati sono equivalenti."

#: src/app/language/PvExplain.ts:50
msgid "The failure of a computation, such as a destructor that does not apply."
msgstr "Il fallimento di un calcolo, come un distruttore che non si applica."

#: src/app/language/PvExplain.ts:51
msgid "Declares the variables of a rewrite rule, an equation, a clause or a query."
msgstr "Dichiara le variabili di una regola di riscrittura, di un'equazione, di una clausola o di una query."

#: src/app/language/PvExplain.ts:52
msgid "Adds rules to a destructor that apply when the rules before them do not."
msgstr "Aggiunge a un distruttore regole che si applicano quando quelle precedenti non si applicano."

#: src/app/language/PvExplain.ts:53
msgid "Defines a macro of declarations, which expand instantiates."
msgstr "Definisce una macro di dichiarazioni, che expand istanzia."

#: src/app/language/PvExplain.ts:54
msgid "Expands a macro of declarations defined with def, with its arguments."
msgstr "Espande una macro di dichiarazioni definita con def, con i suoi argomenti."

#: src/app/language/PvExplain.ts:55
msgid "Sets an option of ProVerif, such as set attacker = passive."
msgstr "Imposta un'opzione di ProVerif, come set attacker = passive."

#: src/app/language/PvExplain.ts:56
msgid "Declares channels: free names of type channel."
msgstr "Dichiara canali: nomi liberi di tipo channel."

#: src/app/language/PvExplain.ts:57
msgid "The end of a process, as 0, in the syntax of CryptoVerif."
msgstr "La fine di un processo, come 0, nella sintassi di CryptoVerif."

#: src/app/language/PvExplain.ts:58
msgid "Declares Horn clauses directly, for the attacker or for predicates."
msgstr "Dichiara direttamente clausole di Horn, per l'attaccante o per i predicati."

#: src/app/language/PvExplain.ts:59
msgid "Declares a fact that always holds, to simplify the clauses."
msgstr "Dichiara un fatto che vale sempre, per semplificare le clausole."

#: src/app/language/PvExplain.ts:60
msgid "Asks whether two processes are observationally equivalent."
msgstr "Chiede se due processi sono osservazionalmente equivalenti."

#: src/app/language/PvExplain.ts:61
msgid "In noninterf: the values that a secret ranges over."
msgstr "In noninterf: i valori che un segreto può assumere."

