#: src/app/language/PvExplain.ts:64
msgid "mess(c, M): the message M is on channel c."
msgstr ""

#: src/app/language/PvExplain.ts:78
msgid "Picks any values that satisfy a condition: let x suchthat p(x) in P."
msgstr ""

